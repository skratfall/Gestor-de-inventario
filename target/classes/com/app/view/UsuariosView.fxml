<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.UsuariosController"
            prefHeight="700.0" prefWidth="900.0">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Gestión de Usuarios" textFill="white">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Administre usuarios, roles y permisos del sistema" textFill="#ecf0f1">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnNuevoUsuario" text="Nuevo Usuario"
                        onAction="#handleNuevoUsuario"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnEditarUsuario" text="Editar"
                        onAction="#handleEditarUsuario"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button fx:id="btnEliminarUsuario" text="Eliminar"
                        onAction="#handleEliminarUsuario"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Button fx:id="btnResetPassword" text="Restablecer Contraseña"
                        onAction="#handleResetPassword"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar usuario..."
                           prefWidth="200"/>
                <Button text="Buscar" onAction="#handleBuscar"
                        style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                <Button text="Refrescar" onAction="#handleRefrescar"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tableUsuarios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUsername" text="Usuario" prefWidth="120"/>
                    <TableColumn fx:id="colNombreCompleto" text="Nombre Completo" prefWidth="180"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="100"/>
                    <TableColumn fx:id="colActivo" text="Estado" prefWidth="80"/>
                    <TableColumn fx:id="colUltimoAcceso" text="Último Acceso" prefWidth="140"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                <Label fx:id="lblTotalUsuarios" text="Total: 0 usuarios"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
