<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.ReportesController" stylesheets="@../css/Reportes.css">
   
   <!-- Top: Navigation Bar -->
   <top>
      <HBox styleClass="nav-bar">
         <children>
            <Label text="📊 Reports y Analytics" styleClass="nav-title" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
               <children>
                  <Button text="🏠 Dashboard" onAction="#handleBack" styleClass="nav-button" />
                  <Button text="📦 Inventory" styleClass="nav-button" />
                  <Button text="💰 Sales" styleClass="nav-button" />
                  <Button text="📋 Orders" styleClass="nav-button" />
                  <Button text="📊 Reports" styleClass="nav-button active" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   
   <!-- Center: Main Content -->
   <center>
      <VBox spacing="25.0" styleClass="padding-large">
         <children>
            <!-- Statistics Cards -->
            <HBox spacing="20.0" alignment="CENTER">
               <children>
                  <!-- Total Sales Card -->
                  <VBox styleClass="stats-card primary" spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="💰" styleClass="stat-icon" />
                        <Label text="Total Sales" styleClass="stat-title" />
                        <Label fx:id="totalSalesLabel" text="" styleClass="stat-value" />
                        <Label text="All time revenue" styleClass="stat-description" />
                     </children>
                  </VBox>
                  
                  <!-- Total Orders Card -->
                  <VBox styleClass="stats-card success" spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="📋" styleClass="stat-icon" />
                        <Label text="Total Orders" styleClass="stat-title" />
                        <Label fx:id="totalOrdersLabel" text="127" styleClass="stat-value" />
                        <Label text="Orders processed" styleClass="stat-description" />
                     </children>
                  </VBox>
                  
                  <!-- Low Stock Items Card -->
                  <VBox styleClass="stats-card danger" spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="⚠️" styleClass="stat-icon" />
                        <Label text="Low Stock Items" styleClass="stat-title" />
                        <Label fx:id="lowStockItemsLabel" text="8" styleClass="stat-value" />
                        <Label text="Need attention" styleClass="stat-description" />
                     </children>
                  </VBox>
                  
                  <!-- Top Product Card -->
                  <VBox styleClass="stats-card warning" spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="🏆" styleClass="stat-icon" />
                        <Label text="Top Product" styleClass="stat-title" />
                        <Label fx:id="topProductLabel" text="Laptop Dell" styleClass="stat-value product-name" />
                        <Label text="Best seller" styleClass="stat-description" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- TabPane for Multiple Reports -->
            <TabPane VBox.vgrow="ALWAYS" styleClass="tab-pane">
               <tabs>
                  <!-- Sales Report Tab -->
                  <Tab text="📊 Sales Reports" closable="false">
                     <content>
                        <HBox spacing="25.0" styleClass="padding-medium">
                           <children>
                              <!-- Left Panel - Report Controls -->
                              <VBox spacing="20.0" styleClass="card" HBox.hgrow="NEVER" prefWidth="350.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label text="⚙️" styleClass="section-icon" />
                                          <Label text="Generate Sales Report" styleClass="section-header" />
                                       </children>
                                    </HBox>
                                    
                                    <!-- Date Range Selection -->
                                    <VBox spacing="15.0" styleClass="control-panel">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="10.0">
                                             <children>
                                                <Label text="📅" styleClass="panel-icon" />
                                                <Label text="Date Range" styleClass="panel-title" />
                                             </children>
                                          </HBox>
                                          
                                          <GridPane hgap="15.0" vgap="10.0">
                                             <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" />
                                                <ColumnConstraints hgrow="ALWAYS" />
                                             </columnConstraints>
                                             <rowConstraints>
                                                <RowConstraints />
                                             </rowConstraints>
                                             <children>
                                                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                   <children>
                                                      <Label text="From:" styleClass="input-label" />
                                                      <DatePicker fx:id="startDatePicker" styleClass="date-picker" />
                                                   </children>
                                                </VBox>
                                                
                                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                   <children>
                                                      <Label text="To:" styleClass="input-label" />
                                                      <DatePicker fx:id="endDatePicker" styleClass="date-picker" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </GridPane>
                                       </children>
                                    </VBox>
                                    
                                    <Separator />
                                    
                                    <!-- Report Generation Buttons -->
                                    <VBox spacing="15.0">
                                       <children>
                                          <Button fx:id="generateSalesReportButton" onAction="#handleGenerateSalesReport" 
                                                  prefWidth="300.0" prefHeight="45.0" styleClass="btn btn-primary">
                                             <graphic>
                                                <HBox spacing="10.0" alignment="CENTER">
                                                   <children>
                                                      <Label text="💰" styleClass="button-icon" />
                                                      <Label text="Generate Sales Report" styleClass="button-text" />
                                                   </children>
                                                </HBox>
                                             </graphic>
                                          </Button>
                                          
                                          <Button fx:id="exportReportButton" onAction="#handleExportReport" 
                                                  prefWidth="300.0" prefHeight="45.0" styleClass="btn btn-secondary">
                                             <graphic>
                                                <HBox spacing="10.0" alignment="CENTER">
                                                   <children>
                                                      <Label text="📄" styleClass="button-icon" />
                                                      <Label text="Export Report" styleClass="button-text" />
                                                   </children>
                                                </HBox>
                                             </graphic>
                                          </Button>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              
                              <!-- Right Panel - Sales Trends Chart -->
                              <VBox spacing="20.0" styleClass="card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label text="📈" styleClass="section-icon" />
                                          <Label text="Sales Trends" styleClass="section-header" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label text="Last 12 months" styleClass="subtitle" />
                                       </children>
                                    </HBox>
                                    
                                    <!-- Sales Trends Chart -->
                                    <BarChart fx:id="salesTrendsChart" VBox.vgrow="ALWAYS" styleClass="bar-chart" prefHeight="400.0">
                                       <xAxis>
                                          <CategoryAxis side="BOTTOM" label="Month" />
                                       </xAxis>
                                       <yAxis>
                                          <NumberAxis side="LEFT" label="Sales ($)" />
                                       </yAxis>
                                    </BarChart>
                                    
                                    <!-- Sales Summary -->
                                    <VBox spacing="10.0" styleClass="summary-panel">
                                       <children>
                                          <Label text="📈 Sales Summary" styleClass="summary-title" />
                                          <HBox spacing="20.0">
                                             <children>
                                                <VBox spacing="5.0">
                                                   <children>
                                                      <Label text="This Month" styleClass="summary-period" />
                                                      <Label fx:id="currentMonthSalesLabel" text="" styleClass="summary-amount current" />
                                                   </children>
                                                </VBox>
                                                <VBox spacing="5.0">
                                                   <children>
                                                      <Label text="Last Month" styleClass="summary-period" />
                                                      <Label fx:id="previousMonthSalesLabel" text="" styleClass="summary-amount previous" />
                                                   </children>
                                                </VBox>
                                                <VBox spacing="5.0">
                                                   <children>
                                                      <Label text="Growth" styleClass="summary-period" />
                                                      <Label fx:id="salesGrowthLabel" text="+21.7%" styleClass="summary-amount growth" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </content>
                  </Tab>
                  
                  <!-- Products Report Tab -->
                  <Tab text="📦 Product Reports" closable="false">
                     <content>
                        <HBox spacing="25.0" styleClass="padding-medium">
                           <children>
                              <!-- Left Panel - Product Controls -->
                              <VBox spacing="20.0" styleClass="card" HBox.hgrow="NEVER" prefWidth="350.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label text="⚙️" styleClass="section-icon" />
                                          <Label text="Product Analysis" styleClass="section-header" />
                                       </children>
                                    </HBox>
                                    
                                    <!-- Product Report Buttons -->
                                    <VBox spacing="15.0">
                                       <children>
                                          <Button fx:id="generateInventoryReportButton" onAction="#handleGenerateInventoryReport" 
                                                  prefWidth="300.0" prefHeight="45.0" styleClass="btn btn-success">
                                             <graphic>
                                                <HBox spacing="10.0" alignment="CENTER">
                                                   <children>
                                                      <Label text="📦" styleClass="button-icon" />
                                                      <Label text="Generate Inventory Report" styleClass="button-text" />
                                                   </children>
                                                </HBox>
                                             </graphic>
                                          </Button>
                                          
                                          <Button fx:id="generateOrdersReportButton" onAction="#handleGenerateOrdersReport" 
                                                  prefWidth="300.0" prefHeight="45.0" styleClass="btn btn-warning">
                                             <graphic>
                                                <HBox spacing="10.0" alignment="CENTER">
                                                   <children>
                                                      <Label text="📋" styleClass="button-icon" />
                                                      <Label text="Generate Orders Report" styleClass="button-text" />
                                                   </children>
                                                </HBox>
                                             </graphic>
                                          </Button>
                                       </children>
                                    </VBox>
                                    
                                    <!-- Top Products Summary -->
                                    <VBox spacing="15.0" styleClass="control-panel">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="10.0">
                                             <children>
                                                <Label text="🏆" styleClass="panel-icon" />
                                                <Label text="Top Selling Products" styleClass="panel-title" />
                                             </children>
                                          </HBox>
                                          
                                          <VBox spacing="10.0">
                                             <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                   <children>
                                                      <Label text="1." styleClass="rank first" />
                                                      <Label fx:id="topProduct1Label" text="Laptop Dell" styleClass="product-name" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="topProduct1QtyLabel" text="45 units" styleClass="quantity" />
                                                   </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                   <children>
                                                      <Label text="2." styleClass="rank second" />
                                                      <Label fx:id="topProduct2Label" text="Monitor 24\''" styleClass="product-name" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="topProduct2QtyLabel" text="32 units" styleClass="quantity" />
                                                   </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                   <children>
                                                      <Label text="3." styleClass="rank third" />
                                                      <Label fx:id="topProduct3Label" text="Mouse Logitech" styleClass="product-name" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="topProduct3QtyLabel" text="28 units" styleClass="quantity" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              
                              <!-- Right Panel - Top-Selling Products Chart -->
                              <VBox spacing="20.0" styleClass="card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label text="🥧" styleClass="section-icon" />
                                          <Label text="Top-Selling Products" styleClass="section-header" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label text="By units sold" styleClass="subtitle" />
                                       </children>
                                    </HBox>
                                    
                                    <!-- Top Products Pie Chart -->
                                    <PieChart fx:id="topProductsChart" VBox.vgrow="ALWAYS" styleClass="pie-chart" prefHeight="400.0" />
                                    
                                    <!-- Product Performance Summary -->
                                    <VBox spacing="10.0" styleClass="summary-panel">
                                       <children>
                                          <Label text="📊 Product Performance" styleClass="summary-title" />
                                          <HBox spacing="20.0">
                                             <children>
                                                <VBox spacing="5.0">
                                                   <children>
                                                      <Label text="Total Products" styleClass="summary-period" />
                                                      <Label fx:id="totalProductsLabel" text="156" styleClass="summary-amount total" />
                                                   </children>
                                                </VBox>
                                                <VBox spacing="5.0">
                                                   <children>
                                                      <Label text="Active Products" styleClass="summary-period" />
                                                      <Label fx:id="activeProductsLabel" text="148" styleClass="summary-amount active" />
                                                   </children>
                                                </VBox>
                                                <VBox spacing="5.0">
                                                   <children>
                                                      <Label text="Low Stock" styleClass="summary-period" />
                                                      <Label fx:id="lowStockCountLabel" text="8" styleClass="summary-amount low-stock" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </content>
                  </Tab>
                  
                  <!-- Report Output Tab -->
                  <Tab text="📄 Report Output" closable="false">
                     <content>
                        <VBox spacing="20.0" styleClass="card padding-large">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label text="📄" styleClass="section-icon" />
                                    <Label text="Generated Reports" styleClass="section-header" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="reportStatusLabel" text="Ready to generate reports" styleClass="subtitle" />
                                 </children>
                              </HBox>
                              
                              <TextArea fx:id="reportTextArea" editable="false" wrapText="true" 
                                        VBox.vgrow="ALWAYS" styleClass="text-area report-output" 
                                        promptText="Generated reports will appear here..." />
                           </children>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </VBox>
   </center>
   
   <!-- Bottom: Footer -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" styleClass="padding-medium footer">
         <children>
            <Button fx:id="backButton" onAction="#handleBack" 
                    prefWidth="150.0" prefHeight="35.0" styleClass="btn btn-secondary">
               <graphic>
                  <HBox spacing="8.0" alignment="CENTER">
                     <children>
                        <Label text="🏠" styleClass="button-icon" />
                        <Label text="Back to Dashboard" styleClass="button-text" />
                     </children>
                  </HBox>
               </graphic>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>