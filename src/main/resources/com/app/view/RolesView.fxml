<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.RolesController"
            prefHeight="700.0" prefWidth="900.0">
    <stylesheets>
        <URL value="@/css/modern-ui.css" />
        <URL value="@/css/theme-light.css" />
    </stylesheets>

    <top>
        <VBox spacing="10" styleClass="module-header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label fx:id="lblPanelTitle" text="Gestión de Roles" styleClass="module-title"/>
            <Label fx:id="lblPanelSubtitle" text="Administre los roles y niveles de acceso del sistema" style="-fx-text-fill: #ecf0f1;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnBackToDashboard" text="🏠 Regresar al Dashboard"
                        onAction="#handleBackToDashboard" styleClass="button-info"/>
                <Button fx:id="btnNuevoRol" text="✨ Nuevo Rol"
                        onAction="#handleNuevoRol" styleClass="button-primary"/>
                <Button fx:id="btnEditarRol" text="✏️ Editar"
                        onAction="#handleEditarRol" styleClass="button-secondary"/>
                <Button fx:id="btnEliminarRol" text="🗑️ Eliminar"
                        onAction="#handleEliminarRol" styleClass="button-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar rol..." styleClass="search-field"
                          prefWidth="200"/>
                <Button fx:id="btnBuscar" text="🔍 Buscar" onAction="#handleBuscar" styleClass="button-info"/>
                <Button fx:id="btnRefrescar" text="🔄 Refrescar" onAction="#handleRefrescar" styleClass="button-info"/>
            </HBox>

            <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
                <!-- Lista de Roles -->
                <VBox spacing="10" styleClass="table-container">
                    <TableView fx:id="tableRoles" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="250"/>
                            <TableColumn fx:id="colNivelAcceso" text="Nivel de Acceso" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblTotalRoles" text="Total: 0 roles" styleClass="total-label"/>
                </VBox>

                <!-- Formulario de Rol -->
                <ScrollPane fitToWidth="true" fitToHeight="true">
                    <VBox fx:id="formPane" spacing="15" styleClass="form-container" visible="false" managed="false">
                        <Label text="Detalles del Rol" styleClass="form-title"/>

                    <GridPane vgap="15" hgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                        <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true"
                                 GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

                        <Label text="Nivel de Acceso:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                        <ComboBox fx:id="cmbNivelAcceso" prefWidth="150"
                                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="btnCancelar" text="Cancelar"
                                onAction="#handleCancelar" styleClass="cancel-button"/>
                        <Button fx:id="btnGuardar" text="Guardar"
                                onAction="#handleGuardar" styleClass="button-primary"/>
                    </HBox>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>