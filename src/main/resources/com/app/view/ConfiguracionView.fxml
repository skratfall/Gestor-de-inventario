<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.ConfiguracionController"
            prefHeight="700.0" prefWidth="900.0">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Configuración del Sistema" textFill="white">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Personalice los parámetros y preferencias del sistema" textFill="#ecf0f1">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnBackToDashboard" text="🏠 Regresar al Dashboard"
                        onAction="#handleBackToDashboard"
                        style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            </HBox>

            <TabPane VBox.vgrow="ALWAYS">
                <!-- Pestaña: Interfaz de Usuario -->
                <Tab text="Interfaz de Usuario" closable="false">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <!-- Tema -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Tema de la Interfaz" style="-fx-font-weight: bold;"/>
                            <RadioButton fx:id="rbTemaClaro" text="Tema Claro" 
                                       toggleGroup="$temaGroup"/>
                            <RadioButton fx:id="rbTemaOscuro" text="Tema Oscuro"
                                       toggleGroup="$temaGroup"/>
                            <Label text="El cambio de tema requiere reiniciar la aplicación"
                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                        </VBox>

                        <Separator/>

                        <!-- Idioma -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Idioma" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="cmbIdioma" prefWidth="200"/>
                            <Label text="El cambio de idioma requiere reiniciar la aplicación"
                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                        </VBox>

                        <Separator/>

                        <!-- Personalización -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Personalización" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtNombreApp" promptText="Nombre de la aplicación"/>
                            <CheckBox fx:id="chkMostrarAyuda" 
                                    text="Mostrar consejos y ayuda"/>
                            <CheckBox fx:id="chkNotificaciones" 
                                    text="Habilitar notificaciones del sistema"/>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Pestaña: Conexión -->
                <Tab text="Conexión" closable="false">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <!-- Supabase -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Configuración de Supabase" 
                                  style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtSupabaseUrl" 
                                     promptText="URL de Supabase"/>
                            <PasswordField fx:id="txtSupabaseKey" 
                                         promptText="API Key de Supabase"/>
                            <Button text="Probar Conexión" 
                                    onAction="#handleTestConnection"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                        </VBox>

                        <Separator/>

                        <!-- Sincronización -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Sincronización" style="-fx-font-weight: bold;"/>
                            <CheckBox fx:id="chkSincAuto" 
                                    text="Habilitar sincronización automática"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Intervalo de sincronización:"/>
                                <ComboBox fx:id="cmbIntervaloSync" prefWidth="150"/>
                            </HBox>
                            <Label text="Estado de sincronización:" 
                                  style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblUltimaSync" 
                                  text="Última sincronización: Nunca"
                                  style="-fx-text-fill: #7f8c8d;"/>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Pestaña: Datos -->
                <Tab text="Datos" closable="false">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <!-- Respaldo -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Respaldo de Datos" 
                                  style="-fx-font-weight: bold;"/>
                            <CheckBox fx:id="chkBackupAuto" 
                                    text="Habilitar respaldo automático"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Frecuencia de respaldo:"/>
                                <ComboBox fx:id="cmbFrecuenciaBackup" 
                                        prefWidth="150"/>
                            </HBox>
                            <Button text="Realizar Respaldo Manual" 
                                    onAction="#handleManualBackup"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                        </VBox>

                        <Separator/>

                        <!-- Mantenimiento -->
                        <VBox spacing="10" styleClass="config-section">
                            <Label text="Mantenimiento" style="-fx-font-weight: bold;"/>
                            <Button text="Limpiar Caché" 
                                    onAction="#handleLimpiarCache"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                            <Button text="Optimizar Base de Datos" 
                                    onAction="#handleOptimizarDB"
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                        </VBox>
                    </VBox>
                </Tab>
            </TabPane>

            <!-- Botones de Acción -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnRestaurarPred" text="Restaurar Valores Predeterminados"
                        onAction="#handleRestaurarPredeterminados"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Button fx:id="btnGuardarConfig" text="Guardar Cambios"
                        onAction="#handleGuardarCambios"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>