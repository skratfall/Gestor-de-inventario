<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.ConfiguracionController"
            prefHeight="700.0" prefWidth="900.0">
    <stylesheets>
        <URL value="@/css/ModernStyles.css" />
        <URL value="@/css/theme-light.css" />
    </stylesheets>

    <top>
        <VBox spacing="10" styleClass="module-header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label fx:id="lblPanelTitle" text="Configuración del Sistema" styleClass="module-title"/>
            <Label fx:id="lblPanelSubtitle" text="Personalice los parámetros y preferencias del sistema" style="-fx-text-fill: #ecf0f1;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnBackToDashboard" text="🏠 Regresar al Dashboard"
                            onAction="#handleBackToDashboard" styleClass="button-info"/>
                </HBox>

                <TabPane VBox.vgrow="ALWAYS">
                <!-- Pestaña: Interfaz de Usuario -->
                <Tab text="Interfaz de Usuario" closable="false">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <!-- Tema -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Tema de la Interfaz" styleClass="field-label"/>
                            <RadioButton fx:id="rbTemaClaro" text="Tema Claro"/>
                            <RadioButton fx:id="rbTemaOscuro" text="Tema Oscuro"/>
                            <Label text="El cambio de tema requiere reiniciar la aplicación"
                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                        </VBox>

                        <Separator/>

                        <!-- Idioma -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Idioma" styleClass="field-label"/>
                            <ComboBox fx:id="cmbIdioma" prefWidth="200"/>
                            <Label text="El cambio de idioma requiere reiniciar la aplicación"
                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                        </VBox>

                        <Separator/>

                        <!-- Personalización -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Personalización" styleClass="field-label"/>
                            <Label text="Nombre de la Aplicación:" styleClass="field-label"/>
                            <TextField fx:id="txtNombreApp" promptText="Nombre de la aplicación" styleClass="form-field"/>
                            <CheckBox fx:id="chkMostrarAyuda" text="Mostrar consejos y ayuda"/>
                            <CheckBox fx:id="chkNotificaciones" text="Habilitar notificaciones del sistema"/>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Pestaña: Conexión -->
                <Tab text="Conexión" closable="false">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <!-- Supabase -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Configuración de Supabase" styleClass="field-label"/>
                            <Label text="URL de Supabase:" styleClass="field-label"/>
                            <TextField fx:id="txtSupabaseUrl" promptText="URL de Supabase" styleClass="form-field"/>
                            <Label text="API Key de Supabase:" styleClass="field-label"/>
                            <PasswordField fx:id="txtSupabaseKey" promptText="API Key de Supabase" styleClass="form-field"/>
                            <Button text="Probar Conexión" onAction="#handleTestConnection" styleClass="button-secondary"/>
                        </VBox>

                        <Separator/>

                        <!-- Sincronización -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Sincronización" styleClass="field-label"/>
                            <CheckBox fx:id="chkSincAuto" text="Habilitar sincronización automática"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Intervalo de sincronización:"/>
                                <ComboBox fx:id="cmbIntervaloSync" prefWidth="150"/>
                            </HBox>
                            <Label text="Estado de sincronización:" styleClass="field-label"/>
                            <Label fx:id="lblUltimaSync" text="Última sincronización: Nunca"
                                  style="-fx-text-fill: #7f8c8d;"/>
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Pestaña: Datos -->
                <Tab text="Datos" closable="false">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <!-- Respaldo -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Respaldo de Datos" styleClass="field-label"/>
                            <CheckBox fx:id="chkBackupAuto" text="Habilitar respaldo automático"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Frecuencia de respaldo:"/>
                                <ComboBox fx:id="cmbFrecuenciaBackup" prefWidth="150"/>
                            </HBox>
                            <Button text="Realizar Respaldo Manual" onAction="#handleManualBackup" styleClass="button-primary"/>
                        </VBox>

                        <Separator/>

                        <!-- Mantenimiento -->
                        <VBox spacing="10" styleClass="section-card">
                            <Label text="Mantenimiento" styleClass="field-label"/>
                            <Button text="Limpiar Caché" onAction="#handleLimpiarCache" styleClass="button-danger"/>
                            <Button text="Optimizar Base de Datos" onAction="#handleOptimizarDB" styleClass="button-warning"/>
                        </VBox>
                    </VBox>
                </Tab>
            </TabPane>

            <!-- Botones de Acción -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnRestaurarPred" text="Restaurar Valores Predeterminados"
                        onAction="#handleRestaurarPredeterminados" styleClass="button-danger"/>
                <Button fx:id="btnGuardarConfig" text="Guardar Cambios"
                        onAction="#handleGuardarCambios" styleClass="button-primary"/>
            </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>