<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.VentasController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
         <children>
            <Label style="-fx-text-fill: white;" text="Sales Management">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
      
      <!-- Sales Form -->
      <HBox spacing="20.0">
         <children>
            <!-- Left Panel - New Sale -->
            <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="New Sale">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <!-- Client Selection -->
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Select Client:" />
                        <ComboBox fx:id="clienteComboBox" prefWidth="200.0" promptText="Choose a client" />
                     </children>
                  </VBox>
                  
                  <!-- Product Selection -->
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Select Product:" />
                        <ComboBox fx:id="productoComboBox" prefWidth="200.0" promptText="Choose a product" />
                     </children>
                  </VBox>
                  
                  <!-- Add to Cart Button -->
                  <Button fx:id="addToCartButton" onAction="#handleAddToCart" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Add to Cart" />
                  
                  <!-- Shopping Cart -->
                  <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label text="Shopping Cart">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        
                        <TableView fx:id="carritoTable" prefHeight="200.0">
                           <columns>
                              <TableColumn fx:id="nombreColumn" prefWidth="120.0" text="Product" />
                              <TableColumn fx:id="categoriaColumn" prefWidth="80.0" text="Category" />
                              <TableColumn fx:id="precioColumn" prefWidth="80.0" text="Price" />
                           </columns>
                        </TableView>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Button fx:id="removeFromCartButton" onAction="#handleRemoveFromCart" style="-fx-background-color: #dc3545; -fx-text-fill: white;" text="Remove" />
                              <Button fx:id="clearCartButton" onAction="#handleClearCart" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Clear Cart" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Total and Process Sale -->
                  <VBox spacing="10.0">
                     <children>
                        <Label fx:id="totalLabel" style="-fx-font-weight: bold;" text="Total: $0.00">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Button fx:id="processSaleButton" onAction="#handleProcessSale" prefWidth="200.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Process Sale" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
            
            <!-- Right Panel - Sales History -->
            <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Sales History">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <TableView fx:id="ventasTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="ventaIdColumn" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="fechaColumn" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="clienteColumn" prefWidth="100.0" text="Client" />
                        <TableColumn fx:id="ventaTotalColumn" prefWidth="80.0" text="Total" />
                     </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      
      <!-- Footer -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="backButton" onAction="#handleBack" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Back to Dashboard" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>