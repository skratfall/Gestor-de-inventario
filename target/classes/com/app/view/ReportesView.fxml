<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.ReportesController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
         <children>
            <Label style="-fx-text-fill: white;" text="Reports">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
      
      <!-- Statistics Cards -->
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <!-- Total Sales Card -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-padding: 15;">
               <children>
                  <Label style="-fx-text-fill: white;" text="Total Sales">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalSalesLabel" style="-fx-text-fill: white;" text="0.00">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Total Orders Card -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-padding: 15;">
               <children>
                  <Label style="-fx-text-fill: white;" text="Total Orders">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalOrdersLabel" style="-fx-text-fill: white;" text="0">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Low Stock Items Card -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-padding: 15;">
               <children>
                  <Label style="-fx-text-fill: white;" text="Low Stock Items">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lowStockItemsLabel" style="-fx-text-fill: white;" text="0">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Top Product Card -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f39c12; -fx-background-radius: 10; -fx-padding: 15;">
               <children>
                  <Label style="-fx-text-fill: white;" text="Top Product">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="topProductLabel" style="-fx-text-fill: white;" text="None">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- Chart Placeholders -->
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Label fx:id="salesChartPlaceholder" alignment="CENTER" prefHeight="150.0" text="📊 Sales Chart" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <Label fx:id="inventoryChartPlaceholder" alignment="CENTER" prefHeight="150.0" text="📈 Inventory Chart" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <Label fx:id="ordersChartPlaceholder" alignment="CENTER" prefHeight="150.0" text="📉 Orders Chart" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
         </children>
      </HBox>
      
      <!-- Report Generation Section -->
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Left Panel - Report Controls -->
            <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
               <children>
                  <Label text="Generate Reports">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <!-- Date Range Selection -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Date Range:">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="From:" />
                                    <DatePicker fx:id="startDatePicker" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="To:" />
                                    <DatePicker fx:id="endDatePicker" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Report Generation Buttons -->
                  <VBox spacing="10.0">
                     <children>
                        <Button fx:id="generateSalesReportButton" onAction="#handleGenerateSalesReport" prefWidth="200.0" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Generate Sales Report" />
                        <Button fx:id="generateInventoryReportButton" onAction="#handleGenerateInventoryReport" prefWidth="200.0" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Generate Inventory Report" />
                        <Button fx:id="generateOrdersReportButton" onAction="#handleGenerateOrdersReport" prefWidth="200.0" style="-fx-background-color: #ffc107; -fx-text-fill: black;" text="Generate Orders Report" />
                        <Button fx:id="exportReportButton" onAction="#handleExportReport" prefWidth="200.0" style="-fx-background-color: #17a2b8; -fx-text-fill: white;" text="Export Report" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
            
            <!-- Right Panel - Report Display -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Report Output">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <TextArea fx:id="reportTextArea" editable="false" prefHeight="400.0" wrapText="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- Footer -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="backButton" onAction="#handleBack" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Back to Dashboard" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>