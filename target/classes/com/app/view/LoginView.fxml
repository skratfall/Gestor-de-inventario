<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.LoginController" styleClass="login-container" stylesheets="@../../css/style.css">
   <children>
      <VBox styleClass="login-card" spacing="30.0" alignment="CENTER" maxWidth="450.0">
         <children>
            <!-- Logo Placeholder -->
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <ImageView fitWidth="200" fitHeight="200" preserveRatio="true">
         <image>
            <Image url="@../images/logo-proyecto.jpg" />
         </image>
      </ImageView>
               </children>
            </VBox>
            
            <!-- Welcome Message -->
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="Bienvenido de vuelta" styleClass="login-title" />
                  <Label text="Ingresa tus credenciales para continuar" styleClass="login-subtitle" />
               </children>
            </VBox>
            
            <!-- Login Form -->
            <VBox spacing="25.0" alignment="CENTER" styleClass="login-form">
               <children>
                  <!-- Username Field -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="👤 Usuario" style="-fx-font-weight: 600; -fx-text-fill: #2c3e50; -fx-font-size: 14px;" />
                        <TextField fx:id="usernameField" prefWidth="350.0" prefHeight="45.0" promptText="Ingresa tu nombre de usuario" styleClass="login-field">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <!-- Password Field -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="🔒 Contraseña" style="-fx-font-weight: 600; -fx-text-fill: #2c3e50; -fx-font-size: 14px;" />
                        <PasswordField fx:id="passwordField" prefWidth="350.0" prefHeight="45.0" promptText="Ingresa tu contraseña" styleClass="login-field">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </PasswordField>
                     </children>
                  </VBox>
                  
                  <!-- Login Button -->
                  <VBox spacing="15.0" alignment="CENTER">
                     <children>
                        <Button fx:id="loginButton" onAction="#handleLogin" prefWidth="350.0" prefHeight="50.0" styleClass="login-btn">
                           <graphic>
                              <HBox spacing="10.0" alignment="CENTER">
                                 <children>
                                    <Label text="🚀" style="-fx-text-fill: white; -fx-font-size: 18px;" />
                                    <Label text="Iniciar Sesión" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" />
                                 </children>
                              </HBox>
                           </graphic>
                        </Button>
                        
                        <Button fx:id="cancelButton" onAction="#handleCancel" prefWidth="350.0" prefHeight="40.0" styleClass="cancel-login-btn">
                           <graphic>
                              <HBox spacing="8.0" alignment="CENTER">
                                 <children>
                                    <Label text="❌" style="-fx-text-fill: #e74c3c;" />
                                    <Label text="Cancelar" style="-fx-text-fill: #e74c3c; -fx-font-weight: 500;" />
                                 </children>
                              </HBox>
                           </graphic>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <!-- Demo Information -->
            <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(52, 152, 219, 0.1); -fx-padding: 15; -fx-background-radius: 8;">
               <children>
                  <Label text="💡 Modo Demo" style="-fx-font-weight: bold; -fx-text-fill: #3498db;" />
                  <Label text="Usa cualquier usuario y contraseña para ingresar" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
                  <Label text="Ejemplo: admin / admin123" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px; -fx-font-style: italic;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>