<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.app.controller.RegisterController"
           style="-fx-background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);">
    <stylesheets>
        <URL value="@/css/modern-ui.css" />
        <URL value="@/css/theme-light.css" />
    </stylesheets>

    <!-- Fondo Oscuro Semi-transparente -->
    <Region style="-fx-background-color: rgba(0, 0, 0, 0.1);"/>

    <!-- Card Principal -->
    <VBox alignment="CENTER" spacing="0" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0.3, 0, 10);">
        <StackPane.margin>
            <Insets/>
        </StackPane.margin>

        <!-- Header Gradient -->
        <VBox spacing="0" style="-fx-background: linear-gradient(180deg, #3498db 0%, #2980b9 100%); -fx-padding: 40 60 40 60;" alignment="CENTER">
            <Label text="✓" style="-fx-font-size: 48px; -fx-text-fill: white; -fx-font-weight: bold;" alignment="CENTER">
                <VBox.margin>
                    <Insets bottom="15"/>
                </VBox.margin>
            </Label>

            <Label text="Crear Cuenta de Administrador" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"
                   alignment="CENTER">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
                <VBox.margin>
                    <Insets bottom="8"/>
                </VBox.margin>
            </Label>

            <Label text="Primera vez? Registre la cuenta administrativa del sistema"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"
                   wrapText="true"
                   alignment="CENTER">
                <VBox.margin>
                    <Insets bottom="0"/>
                </VBox.margin>
            </Label>
        </VBox>

        <!-- Formulario Container -->
        <VBox spacing="20" style="-fx-background-color: #f5f7fa; -fx-padding: 40 60 40 60;">

            <!-- Nombre Completo -->
            <VBox spacing="8">
                <Label text="Nombre Completo" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="nombreCompletoField"
                           promptText="Ej: Juan García López"
                           style="-fx-padding: 12px 15px; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-color: #d0d8e0; -fx-border-width: 2; -fx-focus-color: #3498db; -fx-faint-focus-color: rgba(52,152,219,0.1);"/>
            </VBox>

            <!-- Usuario -->
            <VBox spacing="8">
                <Label text="Nombre de Usuario" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="usernameField"
                           promptText="Ej: juangarcia"
                           style="-fx-padding: 12px 15px; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-color: #d0d8e0; -fx-border-width: 2; -fx-focus-color: #3498db; -fx-faint-focus-color: rgba(52,152,219,0.1);"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="8">
                <Label text="Correo Electrónico" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="emailField"
                           promptText="correo@empresa.com"
                           style="-fx-padding: 12px 15px; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-color: #d0d8e0; -fx-border-width: 2; -fx-focus-color: #3498db; -fx-faint-focus-color: rgba(52,152,219,0.1);"/>
            </VBox>

            <!-- Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Mínimo 6 caracteres"
                               style="-fx-padding: 12px 15px; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-color: #d0d8e0; -fx-border-width: 2; -fx-focus-color: #3498db; -fx-faint-focus-color: rgba(52,152,219,0.1);"/>
            </VBox>

            <!-- Confirmar Contraseña -->
            <VBox spacing="8">
                <Label text="Confirmar Contraseña" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Repita la contraseña"
                               style="-fx-padding: 12px 15px; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-color: #d0d8e0; -fx-border-width: 2; -fx-focus-color: #3498db; -fx-faint-focus-color: rgba(52,152,219,0.1);"/>
            </VBox>

            <!-- Botones -->
            <HBox spacing="15" alignment="CENTER">
                <VBox.margin>
                    <Insets top="20"/>
                </VBox.margin>

                <!-- Botón Registrar -->
                <Button fx:id="registerButton"
                        text="✓ Registrar Administrador"
                        onAction="#handleRegister"
                        style="-fx-background: linear-gradient(180deg, #3498db 0%, #2980b9 100%); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 40 14 40; -fx-cursor: hand; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.4), 10, 0.3, 0, 4);">
                    <cursor>
                        <javafx.scene.Cursor fx:constant="HAND"/>
                    </cursor>
                    <HBox.margin>
                        <Insets right="10"/>
                    </HBox.margin>
                </Button>

                <!-- Botón Cancelar -->
                <Button fx:id="cancelButton"
                        text="✕ Salir"
                        onAction="#handleCancel"
                        style="-fx-background-color: #ecf0f1; -fx-text-fill: #e74c3c; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 40 14 40; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-color: #e74c3c; -fx-border-width: 2;">
                    <cursor>
                        <javafx.scene.Cursor fx:constant="HAND"/>
                    </cursor>
                    <HBox.margin>
                        <Insets left="10"/>
                    </HBox.margin>
                </Button>
            </HBox>

            <!-- Nota de Información -->
            <Label text="ℹ Esta es la única vez que verá este formulario. Registre cuidadosamente los datos del administrador."
                   style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"
                   wrapText="true"
                   alignment="CENTER">
                <padding>
                    <Insets top="20"/>
                </padding>
            </Label>
        </VBox>
    </VBox>
</StackPane>
