<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.InventarioController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
         <children>
            <Label style="-fx-text-fill: white;" text="Inventory Management">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
      
      <!-- Product Form -->
      <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            <Label text="Product Information">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Product Name:" />
                        <TextField fx:id="nombreField" promptText="Enter product name" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Category:" />
                        <TextField fx:id="categoriaField" promptText="Enter category" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Price:" />
                        <TextField fx:id="precioField" promptText="0.00" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Stock:" />
                        <TextField fx:id="stockField" promptText="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Form Buttons -->
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="addButton" onAction="#handleAdd" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Add Product" />
                  <Button fx:id="updateButton" onAction="#handleUpdate" style="-fx-background-color: #ffc107; -fx-text-fill: black;" text="Update Product" />
                  <Button fx:id="deleteButton" onAction="#handleDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white;" text="Delete Product" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      
      <!-- Products Table -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Products List">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <TableView fx:id="productosTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="nombreColumn" prefWidth="200.0" text="Name" />
                  <TableColumn fx:id="categoriaColumn" prefWidth="150.0" text="Category" />
                  <TableColumn fx:id="precioColumn" prefWidth="100.0" text="Price" />
                  <TableColumn fx:id="stockColumn" prefWidth="80.0" text="Stock" />
               </columns>
            </TableView>
         </children>
      </VBox>
      
      <!-- Footer -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="backButton" onAction="#handleBack" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Back to Dashboard" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>