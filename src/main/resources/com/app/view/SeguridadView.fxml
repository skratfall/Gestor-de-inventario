<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.SeguridadController"
            prefHeight="700.0" prefWidth="900.0">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Configuración de Seguridad" textFill="white">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Configure las políticas de seguridad y monitoree eventos del sistema" textFill="#ecf0f1">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnBackToDashboard" text="🏠 Regresar al Dashboard"
                        onAction="#handleBackToDashboard"
                        style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            </HBox>

            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                <!-- Panel Izquierdo - Configuración -->
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Políticas de Seguridad" styleClass="section-title">
                        <font>
                            <Font name="System Bold" size="16.0"/>
                        </font>
                    </Label>

                    <!-- 2FA -->
                    <VBox spacing="10" styleClass="config-section">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox fx:id="chk2FA" text="Autenticación de Dos Factores (2FA)"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnConfigura2FA" text="Configurar"
                                    onAction="#handleConfigura2FA"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                        </HBox>
                        <Label text="Requiere verificación adicional al iniciar sesión"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                    </VBox>

                    <Separator/>

                    <!-- Bloqueo de Sesión -->
                    <VBox spacing="10" styleClass="config-section">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox fx:id="chkBloqueoSesion" text="Bloqueo por Inactividad"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="cmbTiempoBloqueo" promptText="Tiempo"/>
                        </HBox>
                        <Label text="La sesión se bloqueará después del tiempo de inactividad seleccionado"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                    </VBox>

                    <Separator/>

                    <!-- Intentos de Login -->
                    <VBox spacing="10" styleClass="config-section">
                        <Label text="Control de Intentos Fallidos"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Intentos máximos:"/>
                            <ComboBox fx:id="cmbIntentosMaximos" promptText="Intentos"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnDesbloquearUsuarios" text="Desbloquear Usuarios"
                                    onAction="#handleDesbloquearUsuarios"
                                    style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>
                        </HBox>
                        <Label text="Después de exceder los intentos, la cuenta se bloqueará temporalmente"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                    </VBox>

                    <Separator/>

                    <!-- Registro de Auditorías -->
                    <VBox spacing="10" styleClass="config-section">
                        <Label text="Registro de Auditorías"/>
                        <CheckBox fx:id="chkAuditoriaAccesos" text="Registrar accesos al sistema"/>
                        <CheckBox fx:id="chkAuditoriaRoles" text="Registrar cambios de roles"/>
                        <CheckBox fx:id="chkAuditoriaConfiguracion" text="Registrar cambios de configuración"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Botones de Acción -->
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="btnReiniciarConfiguracion" text="Reiniciar Configuración"
                                onAction="#handleReiniciarConfiguracion"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                        <Button fx:id="btnGuardarConfiguracion" text="Guardar Cambios"
                                onAction="#handleGuardarConfiguracion"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>

                <!-- Panel Derecho - Eventos -->
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Eventos de Seguridad" styleClass="section-title">
                        <font>
                            <Font name="System Bold" size="16.0"/>
                        </font>
                    </Label>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ComboBox fx:id="cmbTipoEvento" promptText="Tipo de evento"/>
                        <TextField fx:id="txtBuscarEvento" promptText="Buscar eventos..."
                                 HBox.hgrow="ALWAYS"/>
                        <Button text="Buscar" onAction="#handleBuscarEventos"
                                style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                        <Button text="Refrescar" onAction="#handleRefrescarEventos"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                    </HBox>

                    <TableView fx:id="tableEventos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFecha" text="Fecha y Hora" prefWidth="150"/>
                            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100"/>
                            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="200"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="lblTotalEventos" text="Total: 0 eventos"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Exportar Eventos" onAction="#handleExportarEventos"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>