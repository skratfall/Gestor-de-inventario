<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.PedidosController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
         <children>
            <Label style="-fx-text-fill: white;" text="Orders Management">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
      
      <!-- Main Content -->
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Left Panel - Orders Table -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Orders List">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <TableView fx:id="pedidosTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="fechaColumn" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="clienteColumn" prefWidth="100.0" text="Client" />
                        <TableColumn fx:id="estadoColumn" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="itemsColumn" prefWidth="60.0" text="Items" />
                        <TableColumn fx:id="totalColumn" prefWidth="80.0" text="Total" />
                     </columns>
                  </TableView>
                  
                  <!-- Action Buttons -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Button fx:id="viewDetailsButton" onAction="#handleViewDetails" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="View Details" />
                        <Button fx:id="refreshButton" onAction="#handleRefresh" style="-fx-background-color: #17a2b8; -fx-text-fill: white;" text="Refresh" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Right Panel - Order Details and Status Update -->
            <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="selectedOrderLabel" text="No order selected">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <!-- Status Update Section -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Update Status:">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <ComboBox fx:id="estadoComboBox" prefWidth="150.0" promptText="Select status" />
                              <Button fx:id="updateStatusButton" onAction="#handleUpdateStatus" style="-fx-background-color: #ffc107; -fx-text-fill: black;" text="Update Status" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Order Details -->
                  <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label text="Order Details:">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        
                        <TextArea fx:id="detailsTextArea" editable="false" prefHeight="300.0" wrapText="true" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      
      <!-- Footer -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="backButton" onAction="#handleBack" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Back to Dashboard" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>