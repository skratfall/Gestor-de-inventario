<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.RegisterController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #f5f5f5;">
    <stylesheets>
        <URL value="@/css/theme-light.css" />
    </stylesheets>

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label fx:id="lblTitle" text="Registro de Administrador" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <Label fx:id="lblSubtitle" text="Bienvenido al Sistema de Gestión de Inventario"
           style="-fx-font-size: 14px; -fx-text-fill: #666666;"
           wrapText="true">
        <padding>
            <Insets bottom="10"/>
        </padding>
    </Label>

    <Separator prefWidth="400">
        <VBox.margin>
            <Insets top="10" bottom="10"/>
        </VBox.margin>
    </Separator>

    <Label text="Por favor, registre la cuenta de administrador inicial del sistema"
           style="-fx-font-size: 12px; -fx-text-fill: #888888;"
           wrapText="true">
        <padding>
            <Insets bottom="20"/>
        </padding>
    </Label>

    <GridPane hgap="10" vgap="15" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
            <ColumnConstraints minWidth="250" prefWidth="250"/>
        </columnConstraints>

        <Label text="Usuario:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="usernameField"
                   promptText="Nombre de usuario"
                   style="-fx-pref-height: 35px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Contraseña:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="passwordField"
                       promptText="Mínimo 6 caracteres"
                       style="-fx-pref-height: 35px;"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Confirmar:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Repita la contraseña"
                       style="-fx-pref-height: 35px;"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Email:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="emailField"
                   promptText="correo@ejemplo.com"
                   style="-fx-pref-height: 35px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Nombre:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="nombreCompletoField"
                   promptText="Nombre completo"
                   style="-fx-pref-height: 35px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>

        <Button fx:id="registerButton"
                text="Registrar Administrador"
                onAction="#handleRegister"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30 10 30; -fx-cursor: hand;">
            <cursor>
                <javafx.scene.Cursor fx:constant="HAND"/>
            </cursor>
        </Button>

        <Button fx:id="cancelButton"
                text="Salir"
                onAction="#handleCancel"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30 10 30; -fx-cursor: hand;">
            <cursor>
                <javafx.scene.Cursor fx:constant="HAND"/>
            </cursor>
        </Button>
    </HBox>

    <Label text="Este formulario solo aparece la primera vez que inicia el sistema"
           style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-font-style: italic;"
           wrapText="true">
        <padding>
            <Insets top="20"/>
        </padding>
    </Label>

</VBox>
