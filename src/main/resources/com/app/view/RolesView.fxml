<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.RolesController"
            prefHeight="700.0" prefWidth="900.0">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Gestión de Roles" textFill="white">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Administre los roles y niveles de acceso del sistema" textFill="#ecf0f1">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnBackToDashboard" text="🏠 Regresar al Dashboard"
                        onAction="#handleBackToDashboard"
                        style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                <Button fx:id="btnNuevoRol" text="✨ Nuevo Rol"
                        onAction="#handleNuevoRol"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnEditarRol" text="✏️ Editar"
                        onAction="#handleEditarRol"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button fx:id="btnEliminarRol" text="🗑️ Eliminar"
                        onAction="#handleEliminarRol"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar rol..."
                          prefWidth="200"/>
                <Button text="🔍 Buscar" 
                        onAction="#handleBuscar"
                        style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                <Button text="🔄 Refrescar" 
                        onAction="#handleRefrescar"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
            </HBox>

            <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
                <!-- Lista de Roles -->
                <VBox spacing="10">
                    <TableView fx:id="tableRoles" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="250"/>
                            <TableColumn fx:id="colNivelAcceso" text="Nivel de Acceso" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblTotalRoles" text="Total: 0 roles"/>
                </VBox>

                <!-- Formulario de Rol -->
                <VBox fx:id="formPane" spacing="15" style="-fx-padding: 20;">
                    <Label text="Detalles del Rol" styleClass="form-title">
                        <font>
                            <Font name="System Bold" size="16.0"/>
                        </font>
                    </Label>

                    <GridPane vgap="15" hgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true"
                                 GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Nivel de Acceso:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbNivelAcceso" prefWidth="150"
                                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="btnCancelar" text="Cancelar"
                                onAction="#handleCancelar"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                        <Button fx:id="btnGuardar" text="Guardar"
                                onAction="#handleGuardar"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>